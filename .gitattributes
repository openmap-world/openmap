# Text files are stored with LF line endings
* text=auto eol=lf
*.lua text eol=lf
*.toc text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
# Binary: never touched by line-ending conversion or diffed as text
*.tga binary
*.png binary
*.blp binary
*.jpg binary
*.ttf binary
